              { "at": { "x": 168, "y": 264 }, "kind": "control panel" },
              { "at": { "x": 504, "y": 72 }, "kind": "bed 1" },
              { "at": { "x": 504, "y": 168 }, "kind": "bed 2" },
              { "at": { "x": 504, "y": 264 }, "kind": "bed 3" }
