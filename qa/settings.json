{
  "name": "settings save the edge scrolling preference and control both cameras",
  "state": "menu",
  "given": { "maps": [{ "name": "room", "file": "qa/fixtures/big_room.json" }] },
  "open": "room",
  "steps": [
    { "press": "Settings" },
    { "expect_state": "settings" },
    { "expect_focus": "Screen edge scrolling: off" },
    { "shot": "settings with edge scrolling off" },
    { "note": "off preserves a stationary camera even with the pointer at the edge" },
    { "goto": "game" },
    { "look_at": { "x": 10, "y": 7 } },
    { "mouse": { "x": 319, "y": 90 } },
    { "wait": 0.5 },
    { "expect_camera": { "x": [10.49, 10.51], "y": [7.49, 7.51] } },
    { "note": "keyboard camera controls still work while edge scrolling is off" },
    { "hold_key": { "key": "d", "seconds": 0.4 } },
    { "expect_camera": { "x": [11.0, 19.0], "y": [7.49, 7.51] } },
    { "goto": "settings" },
    { "key": "enter" },
    { "expect_focus": "Screen edge scrolling: on" },
    { "shot": "settings with edge scrolling on" },
    { "pad": "b" },
    { "expect_state": "menu" },
    { "press": "Settings" },
    { "expect_focus": "Screen edge scrolling: on" },
    { "note": "the enabled preference moves the game camera on both axes" },
    { "goto": "game" },
    { "mouse": { "x": 160, "y": 90 } },
    { "look_at": { "x": 10, "y": 7 } },
    { "mouse": { "x": 319, "y": 90 } },
    { "wait": 0.5 },
    { "expect_camera": { "x": [11.0, 19.0], "y": [7.49, 7.51] } },
    { "mouse": { "x": 160, "y": 179 } },
    { "wait": 0.5 },
    { "expect_camera": { "x": [11.0, 19.0], "y": [1.0, 7.0] } },
    { "note": "a modal suspends edge scrolling" },
    { "mouse": { "x": 160, "y": 90 } },
    { "press": "spawn" },
    { "look_at": { "x": 10, "y": 7 } },
    { "mouse": { "x": 319, "y": 90 } },
    { "wait": 0.5 },
    { "expect_camera": { "x": [10.49, 10.51], "y": [7.49, 7.51] } },
    { "press": "close" },
    { "note": "the editor uses the same preference" },
    { "mouse": { "x": 160, "y": 90 } },
    { "goto": "editor" },
    { "look_at": { "x": 10, "y": 7 } },
    { "mouse": { "x": 319, "y": 90 } },
    { "wait": 0.5 },
    { "expect_camera": { "x": [11.0, 30.0], "y": [7.49, 7.51] } },
    { "goto": "settings" },
    { "pad": "a" },
    { "expect_focus": "Screen edge scrolling: off" },
    { "goto": "editor" },
    { "look_at": { "x": 10, "y": 7 } },
    { "wait": 0.5 },
    { "expect_camera": { "x": [10.49, 10.51], "y": [7.49, 7.51] } },
    { "goto": "settings" },
    { "key": "down" },
    { "expect_focus": "Back" },
    { "key": "enter" },
    { "expect_state": "menu" },
    { "press": "Settings" },
    { "key": "esc" },
    { "expect_state": "menu" }
  ]
}
