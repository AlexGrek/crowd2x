{
  "name": "the visible log follows the highlighted person and keeps important world notices",
  "state": "game",
  "timeout": 180,
  "given": { "maps": [{ "name": "yard", "file": "qa/fixtures/yard.json" }] },
  "open": "yard",
  "steps": [
    { "expect_visible_log": "opened yard" },
    { "key": "p" },
    { "expect_no_visible_log": "speed paused" },
    { "spawn": { "kind": "human", "x": 7, "y": 4 } },
    { "spawn": { "kind": "dog", "x": 8, "y": 4 } },
    { "tick": 1 },
    { "expect_log": "spawned dog" },
    { "expect_no_visible_log": "spawned" },
    { "shot": "no selection shows world notices only" },

    { "note": "selecting somebody recovers their recent activity, even while paused" },
    { "select": 0 },
    { "expect_visible_log": "spawned human" },
    { "expect_no_visible_log": "spawned dog" },
    { "press": "life" },
    { "press": "freeze" },
    { "tick": 1 },
    { "expect_visible_log": "froze human" },
    { "shot": "highlighted human activity" },

    { "select": 1 },
    { "expect_visible_log": "spawned dog" },
    { "expect_no_visible_log": "froze human" },
    { "press": "life" },
    { "press": "freeze" },
    { "tick": 1 },
    { "expect_visible_log": "froze dog" },
    { "select": 0 },
    { "expect_visible_log": "froze human" },
    { "expect_no_visible_log": "froze dog" },

    { "note": "a save is an important global notice, visible with or without a selection" },
    { "key": "f5" },
    { "expect_saves": { "count": 1, "quick": 1 } },
    { "expect_visible_log": "saved \"quick save\"" },
    { "press": "close" },
    { "expect_selected": null },
    { "expect_no_visible_log": "froze" },
    { "expect_no_visible_log": "spawned" },
    { "expect_visible_log": "saved \"quick save\"" },
    { "shot": "world notices remain after deselection" },

    { "key": "esc" },
    { "expect_state": "maps" },
    { "press": "yard" },
    { "expect_visible_log": "opened yard" },
    { "expect_no_visible_log": "saved" },
    { "expect_no_visible_log": "froze" }
  ]
}
