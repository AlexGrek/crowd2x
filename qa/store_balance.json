        "food_in_fridges": true,
        "capacity": 1
      }
    },
    {
      "observe": {
        "name": "shop balance day 2",
        "ticks": 46080,
        "every": 7680
      }
    },
    {
      "expect_superfridge": {
        "min": 0.001,
        "max": 100,
        "food_in_fridges": true,
        "capacity": 1
      }
    },
    {
      "observe": {
        "name": "shop balance day 3",
        "ticks": 46080,
        "every": 7680
      }
    },
    {
      "expect_superfridge": {
        "min": 0.001,
        "max": 100,
        "food_in_fridges": true,
        "capacity": 1
      }
    },
    {
