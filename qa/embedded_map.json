    { "expect_tile": { "map": "inline", "x": 0, "y": 0, "terrain": "floor" } },
    { "expect_tile": { "map": "inline", "x": 2, "y": 0, "terrain": "block" } },
    { "expect_tile": { "map": "inline", "x": 1, "y": 1, "terrain": "void" } },
    { "shot": "an embedded map" },

    { "note": "the impassable cells are impassable, which is the point of painting them" },
