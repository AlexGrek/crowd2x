      {
        "name": "inline",
        "map": {
          "version": 1,
          "size": { "width": 3, "height": 2 },
          "terrain": {
            "palette": ["void", "floor", "block"],
            "layers": [ { "rows": ["1,1,2", "1,0,1"] } ]
          },
          "objects": { "props": [], "spawners": [] }
        }
      }
    ]
