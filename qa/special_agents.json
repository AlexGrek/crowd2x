{
  "name": "a district employs only two special agents who walk around every day",
  "state": "game",
  "timeout": 180,
  "given": { "maps": [{ "name": "district", "district": 7 }] },
  "open": "district",
  "steps": [
    { "key": "p" },
    { "expect_speed": "paused" },
    { "press": "statistics" },
    { "expect_text": "special agents of 2 posts" },
    { "press": "close" },
    { "note": "Seed 7's two special agents are arrivals 101 and 102. Both keep the same daily nine-to-five, with no commute or weekends." },
    { "select": 101 },
    { "expect_selected": "human" },
    { "process": { "name": "hunger", "on": false } },
    { "process": { "name": "thirst", "on": false } },
    { "process": { "name": "bladder", "on": false } },
    { "process": { "name": "fun", "on": false } },
    { "process": { "name": "energy", "on": false } },
    { "press": "job" },
    { "expect_text": "special agent" },
    { "expect_text": "09:00-17:00" },
    { "expect_text": "Mon-Sun" },
    { "tick": 2100 },
    { "expect_text": "walking around the district" },
    { "shot": "the special agent's daily job" },
    { "press": "clothing" },
    { "expect_text": "wearing: uniform special agent (own: " },
    { "press": "brains" },
    { "expect_text": "wander" },
    { "press": "brains" },
    { "press": "follow" },
    { "key": "e" },
    { "key": "e" },
    { "wait": 0.3 },
    { "shot": "the special agent walking in a charcoal suit" },
    { "select": 102 },
    { "press": "job" },
    { "expect_text": "special agent" },
    { "expect_text": "09:00-17:00" },
    { "expect_text": "Mon-Sun" }
  ]
}
